# Supabase (Database)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_anon_key"
SUPABASE_SERVICE_ROLE_KEY="your_service_role_key"

# Better Auth (Authentication)
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_ID].supabase.co:5432/postgres"
BETTER_AUTH_SECRET="your-secret-key-at-least-32-characters-long"  # Generate with: openssl rand -base64 32
BETTER_AUTH_URL="http://localhost:3000"                            # Production: https://your-domain.com

# WAVE AI (single approved provider)
OPENAI_API_KEY=""                                      # Server-only. Production uses the approved OpenAI project key.

# PostHog (disabled by default; use only the isolated EU `Re-New WAVE` project)
NEXT_PUBLIC_POSTHOG_ENABLED="false"
NEXT_PUBLIC_POSTHOG_KEY=""                             # Public project token; never reuse another product's token.
NEXT_PUBLIC_POSTHOG_ENVIRONMENT="local"                # production | preview | development | test | local
NEXT_PUBLIC_POSTHOG_IS_TEST="true"
POSTHOG_ENABLED="false"                                # Server-side `$ai_generation` capture switch.
POSTHOG_PROJECT_TOKEN=""                               # Same isolated project's public token, server-side.
POSTHOG_ENVIRONMENT="local"
POSTHOG_IS_TEST="true"

# Email Automation (Resend)
RESEND_API_KEY="re_xxxxxxxxxxxx"                       # Required for email automation. Get from resend.com
RESEND_FROM_EMAIL="noreply@your-domain.com"            # Must be verified in Resend dashboard
RESEND_WEBHOOK_SECRET="whsec_xxxxxxxxxxxx"             # For tracking opens/clicks
RENEW_STAFF_NOTIFICATION_EMAIL="contact@re-new.team"   # Optional shared inbox for internal interest alerts
WAVE_CRITICAL_ALERT_EMAIL="alerts@your-domain.com"      # Optional internal recipient for content-free critical-operation alerts

# Vercel Cron Jobs
CRON_SECRET="your_cron_secret_here"                    # Secret for Vercel cron job authentication
