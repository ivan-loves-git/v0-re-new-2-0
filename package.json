{
  "name": "my-v0-project",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "pnpm release:check-build-number && next build",
    "data-model:check": "node scripts/check-ma-data-model-sync.mjs",
    "design:check": "node scripts/check-wave-visual-policy.mjs && node .agents/skills/impeccable/scripts/detect.mjs app components styles",
    "w098:source-preflight": "node scripts/verify-w098-source-workbook.mjs",
    "dev": "next dev",
    "lint": "pnpm data-model:check && eslint .",
    "qa:browser": "playwright test",
    "qa:browser:clean-run": "node scripts/qa/verify-playwright-clean-run.mjs",
    "qa:artifacts:sanitize": "node scripts/qa/sanitize-phase-b-artifacts.mjs",
    "qa:evidence:collect": "node scripts/qa/collect-live-evidence.mjs",
    "qa:deploy:admitted": "node scripts/qa/deploy-admitted-candidate.mjs",
    "qa:provider-evidence:load": "node scripts/qa/load-provider-evidence.mjs",
    "qa:alias-sha:resolve": "node scripts/qa/resolve-alias-sha.mjs",
    "qa:deployed-contract:verify": "node scripts/qa/verify-deployed-contract.mjs",
    "qa:fixture:cleanup": "node scripts/qa/cleanup-phase-b.mjs",
    "qa:fixture:manifest": "node scripts/qa/create-phase-b-manifest.mjs",
    "qa:fixture:manifest-rehearsal": "node scripts/qa/create-phase-a-rehearsal-manifest.mjs",
    "qa:fixture:readback": "node scripts/qa/readback-phase-b.mjs",
    "qa:fixture:seed": "node scripts/qa/seed-phase-b-fixtures.mjs",
    "qa:lease:acquire": "node scripts/qa/lease-phase-b.mjs acquire",
    "qa:lease:heartbeat": "node scripts/qa/lease-phase-b.mjs heartbeat",
    "qa:lease:release": "node scripts/qa/lease-phase-b.mjs release",
    "qa:preflight-isolation": "node scripts/qa/preflight-isolation.mjs",
    "qa:fixture:rehearse-cleanup": "node scripts/qa/rehearse-fixture-cleanup.mjs",
    "qa:schema:reconstruct": "node scripts/qa/reconstruct-preview-schema.mjs",
    "qa:schema:sync": "node scripts/qa/sync-permanent-schema.mjs",
    "qa:schema:artifact:verify": "node scripts/qa/verify-schema-artifact.mjs supabase/schema/771_public_schema.sql && (cd supabase/schema && shasum -a 256 -c 771_public_schema.sha256)",
    "qa:schema:verify": "node scripts/qa/verify-permanent-contract.mjs",
    "release:check-build-number": "node scripts/check-release-build-number.mjs",
    "release:prepare-build-number": "node scripts/bump-release-build-number.mjs",
    "security:verify-pdf-worker-trace": "node scripts/verify-pdf-worker-server-trace.mjs",
    "typecheck": "tsc --noEmit",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-accordion": "1.2.2",
    "@radix-ui/react-alert-dialog": "1.1.4",
