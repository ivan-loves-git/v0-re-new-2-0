# Re-New test environment template
# Decision: Phase 1.1 uses a separate Supabase test project.
# Copy to .env.local inside the test worktree only. Do not commit real secrets.
# Never point the Phase 1.1 worktree at the current/shared Supabase database.

# Supabase test/staging project
NEXT_PUBLIC_SUPABASE_URL="https://your-test-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_test_anon_key"
SUPABASE_SERVICE_ROLE_KEY="your_test_service_role_key"

# Better Auth test database connection
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[TEST_PROJECT_ID].supabase.co:5432/postgres"
BETTER_AUTH_SECRET="generate-a-test-secret-with-openssl-rand-base64-32"
BETTER_AUTH_URL="http://localhost:3011"

# Optional providers for test runs
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""
RESEND_WEBHOOK_SECRET=""
CRON_SECRET=""
