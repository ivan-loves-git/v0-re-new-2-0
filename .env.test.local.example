# Re-New isolated QA environment template
# Production and shared-project testing are forbidden. Copy only branch-specific
# values into an untracked local file or encrypted provider store.
# Run `pnpm qa:preflight-isolation` before any remote QA mutation.

# Ephemeral, data-less Supabase preview branch (never production)
QA_SUPABASE_PROJECT_REF="your_preview_branch_ref"
NEXT_PUBLIC_SUPABASE_URL="https://your_preview_branch_ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="encrypted_preview_anon_key"
SUPABASE_SERVICE_ROLE_KEY="encrypted_preview_service_role_key"

# Better Auth database connection
DATABASE_URL="postgresql://postgres.your_preview_branch_ref:***@preview-pooler-host:6543/postgres"
BETTER_AUTH_SECRET="encrypted_test_only_secret_at_least_32_characters"
BETTER_AUTH_URL="https://your-approved-validation-deployment.vercel.app"
NEXT_PUBLIC_APP_URL="https://your-approved-validation-deployment.vercel.app"
QA_BROWSER_BASE_URL="https://your-approved-validation-deployment.vercel.app"
QA_VALIDATION_ORIGIN="https://your-approved-validation-deployment.vercel.app"

# Exact synthetic-fixture contract. The manifest must exist before creation.
QA_RUN_ID="YYYYMMDD-phase-a"
QA_FIXTURE_PREFIX="TEST-YYYYMMDD-phase-a"
QA_FIXTURE_MANIFEST_FILE="/private/tmp/renew-qa-fixtures.json"
QA_PREFLIGHT_EVIDENCE_FILE="/private/tmp/renew-qa-preflight-evidence.json"

# WAVE AI test provider
OPENAI_API_KEY=""

# PostHog stays off in local/test work unless a bounded synthetic verification
# explicitly opts in to the isolated EU `Re-New WAVE` project.
NEXT_PUBLIC_POSTHOG_ENABLED="false"
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_ENVIRONMENT="test"
NEXT_PUBLIC_POSTHOG_IS_TEST="true"
POSTHOG_ENABLED="false"
POSTHOG_PROJECT_TOKEN=""
POSTHOG_ENVIRONMENT="test"
POSTHOG_IS_TEST="true"

RESEND_API_KEY="encrypted_test_only_key"
RESEND_FROM_EMAIL="onboarding@resend.dev"
QA_EMAIL_RECIPIENT="delivered@resend.dev"
RESEND_WEBHOOK_SECRET=""
CRON_SECRET=""
