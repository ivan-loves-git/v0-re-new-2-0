# Re-New test environment template
# Decision: Phase 1.1 uses the same/current Re-New Supabase project,
# approved by Ivan on 2026-05-17 to avoid extra Supabase project cost.
# Copy to .env.local inside the worktree only. Do not commit real secrets.
# This is not an isolated sandbox; treat migrations as controlled production-style changes.

# Approved Supabase project
NEXT_PUBLIC_SUPABASE_URL="https://your-approved-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_approved_anon_key"
SUPABASE_SERVICE_ROLE_KEY="your_approved_service_role_key"

# Better Auth database connection
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[APPROVED_PROJECT_ID].supabase.co:5432/postgres"
BETTER_AUTH_SECRET="generate-or-use-approved-secret"
BETTER_AUTH_URL="http://localhost:3011"

# Optional providers for test runs
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""
RESEND_WEBHOOK_SECRET=""
CRON_SECRET=""
